Package: intel-edge-graphics-core
Architecture: amd64
Depends:
# from mesa
 libegl-mesa0,
 libegl1-mesa-dev,
 libgbm-dev,
 libgbm1,
 libgl1-mesa-dev,
 libgl1-mesa-dri,
 libgles2-mesa-dev,
 libglx-mesa0,
 mesa-common-dev,
 mesa-drm-shim,
 mesa-libgallium,
 mesa-opencl-icd,
 mesa-vulkan-drivers,
# from libdrm (installed from Ubuntu repo)
 libdrm2,
# from dkms
 edge-gfx-dkms
Description: Intel Edge graphics core runtime metapackage
 Installs the core Intel Edge graphics runtime stack for headless or CLI systems.
 This metapackage provides Mesa and GPU userspace dependencies without display
 server components such as Wayland, Xorg, or desktop compositors.

